# 複製成 .env 後填入實際值（.env 不會進版控）
APP_ROOT=/path/to/apiworker
APP_IP=0.0.0.0

# ClickHouse
CH_HOST=localhost
CH_DB=recsys
CH_SRC_PREFIX=src_
USER_IMAGE_TABLE=user_image

# MySQL（原始資料來源）
MYSQL_HOST=localhost
MYSQL_DB=your_db
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

# Memcache
MEMCACHE_HOST=localhost:11211

# 其他（airmodule.py）
DB_HOST=localhost
BEHAVIOR_DB=behavior
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
